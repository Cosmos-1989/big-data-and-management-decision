  "definitionInsertions": [
    {
      "term": "业务对象",
      "anchor": "concept-business-object",
      "action": "anchor_existing",
      "section": "数据驱动决策的基本对象",
      "definition": "业务对象是企业经营中可以被识别、记录、比较和管理的实体或事件，例如客户、订单、产品、供应商、库存批次、工单、审批实例和流程事件。",
      "usedByChapter02": true,
      "id": "concept-business-object",
      "aliases": [
        "业务实体"
      ]
    },
    {
      "term": "业务关系",
      "anchor": "concept-business-relation",
      "action": "add_definition",
      "after": "业务对象",
      "definition": "业务关系是业务对象之间具有明确业务含义的联系，例如订单属于某位客户、订单明细记录某种商品。",
      "usedByChapter02": true,
      "id": "concept-business-relation",
      "aliases": [],
      "insertAfterDefinition": "业务对象"
    },
    {
      "term": "关系约束",
      "anchor": "concept-relation-constraint",
      "action": "add_definition",
      "after": "业务关系",
      "definition": "关系约束规定业务对象之间的联系必须满足的条件，包括是否必须存在、可以关联多少个对象，以及关联在何种时间条件下有效。",
      "example": "在规定每条明细只能属于一张订单的业务制度下，一张订单可以包含多条明细，但每条明细必须且只能关联一张订单。",
      "caution": "业务约束不等同于外键约束；主键、外键等技术约束只实现其中一部分规则。",
      "usedByChapter02": true,
      "id": "concept-relation-constraint",
      "aliases": [
        "关联约束"
      ],
      "insertAfterDefinition": "业务关系"
    },
    {
      "term": "事实粒度",
      "anchor": "concept-fact-grain",
      "action": "add_definition",
      "after": "关系约束",
      "definition": "事实粒度规定一条业务事实记录代表什么对象或事件，以及记录所对应的时间范围。",
      "example": "订单明细表的一条记录表示一张订单中的一种商品明细；库存快照表的一条记录表示某日结束时某商品在某仓库的库存。",
      "caution": "粒度是记录的业务含义，不等同于主键、时间粒度或唯一性。",
      "usedByChapter02": true,
      "id": "concept-fact-grain",
      "aliases": [
        "记录粒度",
        "表粒度"
      ],
      "insertAfterDefinition": "关系约束"
    }
  ],
