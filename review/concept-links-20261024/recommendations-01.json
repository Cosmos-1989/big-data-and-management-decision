  "newCourseDefinitions": [
    {
      "id": "concept-data-information-model",
      "term": "数据、信息与模型",
      "aliases": [
        "数据",
        "信息",
        "模型"
      ],
      "definition": "数据是对对象、事件或状态的记录；信息是结合业务语境解释记录后形成的认识；模型是为回答特定问题而对对象、关系与假设作出的简化表示。",
      "insertBeforeHeading": "管理决策的研究对象"
    },
    {
      "id": "concept-record-field-table",
      "term": "记录、字段与数据表",
      "aliases": [
        "记录",
        "字段",
        "数据表"
      ],
      "definition": "字段对应记录中的一项属性；一条记录组合描述一个规定的业务单位；数据表按相同字段结构组织多条记录。例如，一条订单明细记录可以包含订单编号、商品编号、数量和单价。",
      "insertBeforeHeading": "数据驱动决策的基本对象"
    },
    {
      "id": "concept-decision-variable",
      "term": "决策变量",
      "aliases": [],
      "definition": "决策变量是由决策者选择或调整、用于表示行动方案的变量。订货数量、加急名单和人员配置都可以成为决策变量。",
      "insertBeforeHeading": "决策系统的对象与层次"
    },
    {
      "id": "concept-probability-expectation",
      "term": "概率与期望",
      "aliases": [
        "概率",
        "期望",
        "期望损失",
        "条件概率",
        "条件期望"
      ],
      "definition": "概率表示给定模型下事件发生的可能性。期望是按各结果的概率加权得到的平均量；例如损失分别为0和100万元、对应概率为0.8和0.2时，期望损失为20万元。条件概率和条件期望是在已知某些观察或信息后计算的概率与平均量。",
      "insertBeforeHeading": "状态行动与条件损失"
    },
    {
      "id": "concept-state-action-loss",
      "term": "状态、行动与损失函数",
      "aliases": [
        "状态",
        "可行行动",
        "可行行动集合",
        "损失函数",
        "行动成本"
      ],
      "definition": "状态描述决策时点与任务有关的业务条件；行动是决策者能够采取的操作。满足预算、资源、制度和授权条件的候选行动组成可行行动集合。损失函数把行动及其结果对应到可比较的代价数值，单独列出的行动成本不得与损失重复核算。",
      "insertBeforeHeading": "状态行动与条件损失"
    },
    {
      "id": "concept-argmin-objective",
      "term": "最小化与最优行动",
      "aliases": [
        "argmin",
        "目标函数",
        "最优行动"
      ],
      "definition": "目标函数是用于比较候选方案的数值准则。最小化目标函数是从可行行动中寻找目标值最低的方案；argmin表示返回使目标值达到最小的行动，而不是该最小数值。",
      "insertBeforeHeading": "状态行动与条件损失"
    },
    {
      "id": "concept-potential-outcome",
      "term": "潜在结果与因果效应",
      "aliases": [
        "潜在结果",
        "干预",
        "因果效应",
        "反事实"
      ],
      "definition": "潜在结果是规定采取某一行动时将出现的结果。对同一对象通常只能观察实际行动对应的结果，未采取行动对应的结果属于反事实。比较不同潜在结果可定义因果效应，但从观测数据估计这种差异还需要研究设计和明确的识别假设。",
      "insertBeforeHeading": "状态行动与条件损失"
    },
    {
      "id": "concept-prior-posterior",
      "term": "先验、信号与后验",
      "aliases": [
        "先验概率",
        "先验",
        "后验概率",
        "后验",
        "检测信号"
      ],
      "definition": "先验概率是在获得本次新观察之前对状态的概率判断；信号是在行动前可以获得的观察；后验概率是结合该信号更新后的状态概率。检测阳性表示发出中断预警，阴性表示未预警，两者都不等同于实际中断或正常状态。",
      "insertBeforeHeading": "贝叶斯更新与条件行动"
    },
    {
